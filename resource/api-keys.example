# Discover API keys — preferred location: ~/.discover/api-keys
# Shell exports always win over values in this file.
#
# Install:
#   mkdir -p ~/.discover
#   cp resource/api-keys.example ~/.discover/api-keys
#   chmod 600 ~/.discover/api-keys
#   # edit ~/.discover/api-keys and fill in keys
#
# Optional: NVD API key for faster CVSS lookups during Active recon.
# Request a free key: https://nvd.nist.gov/developers/request-an-api-key
#
# NVD_API_KEY=your-key-here
#
# Optional: Shodan API key for post-Active host enrichment (Domain menu 11)
# and Subdomains Shodan Update. Membership or higher:
#   https://account.shodan.io / https://www.shodan.io/store/member
# IP host lookups do not consume query credits.
#
# SHODAN_API_KEY=your-key-here
#
# Optional: WPScan API token for WordPress host scans (vuln DB / better matching).
# Free token: https://wpscan.com/api (or https://wpscan.com/register)
# Used as --api-token when launching wpscan from Subdomains expand.
#
# WPSCAN_API_TOKEN=your-token-here
#
# Optional: Serply API key for running Google dorks through the search API
# (Domain menu 4). With a key set, results are collected to google-dorks.txt
# instead of opening 14 browser tabs; without one, the browser flow is used.
# Free key: https://serply.io
#
# SERPLY_API_KEY=your-key-here
