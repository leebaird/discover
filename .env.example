# Legacy template — prefer ~/.discover/api-keys for API keys.
#
# Recommended:
#   mkdir -p ~/.discover
#   cp resource/api-keys.example ~/.discover/api-keys
#   chmod 600 ~/.discover/api-keys
#   # edit ~/.discover/api-keys
#
# This file ($DISCOVER/.env or ~/.discover/.env) is still loaded as a fallback.
# Shell exports always win over file values.
#
# NVD_API_KEY=your-key-here
# SHODAN_API_KEY=your-key-here
# WPSCAN_API_TOKEN=your-token-here

